<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mini Message Board | <%= title %></title>
  <style>
    body {
      font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Oxygen,
        Ubuntu,
        Cantarell,
        "Open Sans",
        "Helvetica Neue",
        sans-serif;
    }
    header {
      display: flex;
      justify-content: space-between;
      margin: 10px 20px;
    }
    a {
      color: grey;
    }
    .message {
      padding: 10px 200px;
      margin: auto;
    }
    .message p {
      font-size: 1.25rem;
    }
    .message h2 {
      color: red;
    }

    .message-details {
      display: flex;
      justify-content: space-between;
      padding: 10px 100px;
    }
    .date {
      color: gray;
    }
    .date p {
      font-size: 0.8rem;
    }
    form {
      display: grid;
      gap: 20px;
      padding-left: 200px;
      font-size: 1.25rem;
    }
    label {
      min-width: 100px;
    }
    input {
      min-width: 300px;
      border-radius: 10px;
      padding: 10px;
    }
    .form-item {
      width: 200px;
      display: flex;
      justify-content: space-between;
    }
    form button {
      width: 100px;
      font-size: 1.5rem;
      padding: 10px;
      border-radius: 10px;
      color: white;
      background-color: red;
    }
  </style>
</head>
