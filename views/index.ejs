<!doctype html>
<html lang="en">
  <%- include ('./partials/head.ejs') %>
  <body>
    <%- include ('./partials/header.ejs') %>
    <main>
      <% if(messages.length > 0){ %>
        <% messages.forEach(message =>  {%>
          <div class="message">
            <div class="info">
          <h2><%= message.author%></h2>
          <p><%= message.message%></p>
          </div>
          <div class="date">
            <p><%= message.added.toLocaleString("en-GB", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  hour12: false
}); %></p>
          </div>
        </div>
        <%  }) %>
        <% } %>
    </main>
  </body>
</html>